CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=your-email-app-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=gosawa_db
DB_PORT=3306

# TiDB Cloud Serverless example:
# DB_HOST=<cluster-host>.tidbcloud.com
# DB_PORT=4000
# DB_USER=<database-user>
# DB_PASSWORD=<database-password>
# DB_NAME=<database-name>
# DB_SSL=true
# DB_CA_CERT=<optional-PEM-certificate-contents>
# DB_CA_PATH=<optional-path-to-PEM-certificate>

# Password-reset emails only. For Gmail, use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false